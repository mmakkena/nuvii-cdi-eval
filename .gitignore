# =============================================================================
# Nuvii CDI Evaluation Framework - Git Ignore
# =============================================================================

# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Poetry
poetry.lock

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# =============================================================================
# Environment & Secrets
# =============================================================================

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# API keys and credentials
*.key
*.pem
credentials.json
secrets.yaml
secrets.json

# =============================================================================
# Evaluation Artifacts
# =============================================================================

# Run outputs (can be large, regeneratable)
runs/
!runs/.gitkeep

# Temporary evaluation data
*.tmp
*.temp

# Large result files
results_*.json
results_*.csv

# Phoenix database files
*.sqlite
*.db

# =============================================================================
# Datasets - PHI Safety
# =============================================================================

# IMPORTANT: Never commit real clinical data
# Only synthetic/sample data should be in the repo

# Real clinical notes (if accidentally created)
datasets/real/
datasets/production/
datasets/phi/

# Large dataset files
*.jsonl.gz
*.parquet

# Keep sample and synthetic datasets
!datasets/samples/
!datasets/synthetic/
!datasets/regression/

# =============================================================================
# IDE & Editor
# =============================================================================

# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# OS Generated
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Logs
# =============================================================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Promptfoo
# =============================================================================

promptfoo/output/
promptfoo/.cache/
promptfoo-output/

# =============================================================================
# Misc
# =============================================================================

# Backup files
*.bak
*.backup

# Compressed files (except in specific dirs)
*.zip
*.tar.gz
*.tgz

# Lock files from other package managers
package-lock.json
yarn.lock
