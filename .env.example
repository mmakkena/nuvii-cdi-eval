# =============================================================================
# Nuvii CDI Evaluation Framework - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control

# =============================================================================
# Nuvii CDI API Configuration
# =============================================================================

# Base URL for the Nuvii CDI Agent API
NUVII_API_URL=http://localhost:8000

# API authentication key (required)
NUVII_API_KEY=your_api_key_here

# Request timeout in seconds (default: 30)
NUVII_TIMEOUT_SECONDS=30

# Maximum retry attempts for failed requests (default: 3)
NUVII_MAX_RETRIES=3

# =============================================================================
# Phoenix Tracing Configuration
# =============================================================================

# Enable/disable Phoenix tracing (default: true)
PHOENIX_ENABLED=true

# Phoenix server endpoint
PHOENIX_ENDPOINT=http://localhost:6006

# Project name for organizing traces
PHOENIX_PROJECT_NAME=nuvii-cdi-eval

# Collect input data in traces (disable for PHI safety)
PHOENIX_COLLECT_INPUTS=false

# Collect output data in traces
PHOENIX_COLLECT_OUTPUTS=true

# =============================================================================
# Evaluation Configuration
# =============================================================================

# Enable PHI redaction in logs and artifacts (default: true)
# IMPORTANT: Keep this true when working with real clinical data
EVAL_PHI_SAFE_MODE=true

# Maximum concurrent API calls (default: 5)
EVAL_CONCURRENCY=5

# Rate limit in requests per minute (default: 60)
EVAL_RATE_LIMIT_RPM=60

# Use deterministic mode (temperature=0) for reproducible results
EVAL_DETERMINISTIC_MODE=true

# Output directory for evaluation results
EVAL_OUTPUT_DIR=./runs

# Logging level: DEBUG, INFO, WARNING, ERROR
EVAL_LOG_LEVEL=INFO

# =============================================================================
# LLM Judge Configuration (Optional)
# =============================================================================

# Enable LLM-based judging for query quality evaluation
LLM_JUDGE_ENABLED=false

# Model to use for LLM judging
LLM_JUDGE_MODEL=gpt-4-turbo-preview

# API key for LLM provider (OpenAI, Anthropic, etc.)
LLM_JUDGE_API_KEY=

# Temperature for LLM judge (default: 0.0 for consistency)
LLM_JUDGE_TEMPERATURE=0.0

# Maximum tokens for judge responses
LLM_JUDGE_MAX_TOKENS=1000

# =============================================================================
# CI/CD Configuration (used in GitHub Actions)
# =============================================================================

# These are typically set as GitHub Secrets, not in .env
# NUVII_API_URL_CI=
# NUVII_API_KEY_CI=
